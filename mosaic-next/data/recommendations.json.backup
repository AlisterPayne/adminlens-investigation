          "clientId": "953348912797-h2fo9tmk42mnrkk0kc6gula9i8ipv3re.apps.googleusercontent.com",
          "details": "Super Admin \"deidre@gafe.co.za\" authorized \"Google AppSheet (Web Application)\" with high-privilege scopes (6 scopes). If this token is abused, it poses a full tenant compromise risk.",
          "remediation": "Review whether this admin account requires this third-party tool. If not required for administration, revoke the token and require the app to run under a dedicated least-privilege service account.",
          "actionType": "REVOKE_OR_RESTRICT",
          "gamCommand": "gam user deidre@gafe.co.za delete token clientid 953348912797-h2fo9tmk42mnrkk0kc6gula9i8ipv3re.apps.googleusercontent.com",
          "familyId": "gcp_proj_953348912797",
